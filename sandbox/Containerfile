# Every coding-agent CLI at the versions in versions.lock, plus wadachi.
# Build with build-image.sh, which passes the pins as build arguments and uses
# `git archive` of one commit as the context. No logins are in the image:
# entrypoint.sh copies them in at start (see README.md).
ARG NODE_IMAGE
FROM ${NODE_IMAGE}

ARG CLAUDE_VERSION
ARG CODEX_VERSION
ARG OPENCODE_VERSION
ARG AGY_URL
ARG AGY_SHA512
ARG GROK_URL
ARG GROK_SHA256
ARG WADACHI_COMMIT

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g --no-fund --no-audit \
      "@anthropic-ai/claude-code@${CLAUDE_VERSION}" "@openai/codex@${CODEX_VERSION}" "opencode-ai@${OPENCODE_VERSION}" \
 && npm cache clean --force

# agy and grok: fixed release URLs, checked against the hashes in versions.lock.
RUN curl -fsSL "$AGY_URL" -o /tmp/agy.tgz \
 && echo "${AGY_SHA512}  /tmp/agy.tgz" | sha512sum -c - \
 && mkdir /tmp/agy && tar -xzf /tmp/agy.tgz -C /tmp/agy \
 && install -m 755 /tmp/agy/antigravity /usr/local/bin/agy \
 && rm -rf /tmp/agy /tmp/agy.tgz
RUN curl -fsSL "$GROK_URL" -o /usr/local/bin/grok \
 && echo "${GROK_SHA256}  /usr/local/bin/grok" | sha256sum -c - \
 && chmod 755 /usr/local/bin/grok

COPY . /opt/wadachi-src
RUN python3 -m venv /opt/wadachi \
 && /opt/wadachi/bin/pip install --no-cache-dir -c /opt/wadachi-src/sandbox/constraints.txt /opt/wadachi-src \
 && ln -s /opt/wadachi/bin/wadachi /usr/local/bin/wadachi \
 && install -D -m 644 /opt/wadachi-src/sandbox/auth-files.txt /etc/wadachi-sandbox/auth-files.txt \
 && install -D -m 644 /opt/wadachi-src/sandbox/versions.lock /etc/wadachi-sandbox/versions.lock \
 && install -m 755 /opt/wadachi-src/sandbox/entrypoint.sh /usr/local/bin/wadachi-sandbox-entry \
 && rm -rf /opt/wadachi-src

# The node image's user 1000 ("node") becomes "agent"; HOME is empty until start.
RUN usermod -l agent -d /home/agent -m node && groupmod -n agent node
USER agent
ENV HOME=/home/agent \
    DISABLE_AUTOUPDATER=1
WORKDIR /work
LABEL org.wadachi.commit="${WADACHI_COMMIT}"
ENTRYPOINT ["/usr/local/bin/wadachi-sandbox-entry"]
CMD ["bash"]
